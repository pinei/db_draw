Table Editora {
  id INTEGER [pk]
  nome VARCHAR(150)
  pais VARCHAR(80)
}
Table Categoria {
  id INTEGER [pk]
  nome VARCHAR(100)
  descricao TEXT
}
Table Autor {
  id INTEGER [pk]
  nome VARCHAR(150)
  nacionalidade VARCHAR(80)
}
Table Livro {
  id INTEGER [pk]
  titulo VARCHAR(200)
  isbn CHAR(13)
  ano_publicacao SMALLINT
  editora_id INTEGER [ref: > editora.id]
  categoria_id INTEGER [ref: > categoria.id]
}
Table LivroAutor {
  livro_id INTEGER [pk, ref: > livro.id]
  autor_id INTEGER [pk, ref: > autor.id]
  ordem SMALLINT
}
Table Usuário {
  id INTEGER [pk]
  nome VARCHAR(150)
  email VARCHAR(200)
  data_cadastro DATE
}
Table Empréstimo {
  id INTEGER [pk]
  usuario_id INTEGER [ref: > usuario.id]
  livro_id INTEGER [ref: > livro.id]
  data_emprestimo DATE
  data_devolucao DATE
}
Table Multa {
  id INTEGER [pk]
  emprestimo_id INTEGER [ref: > emprestimo.id]
  valor DECIMAL(10,2)
  paga BOOLEAN
}
Table Reserva {
  id INTEGER [pk]
  usuario_id INTEGER [ref: > usuario.id]
  livro_id INTEGER [ref: > livro.id]
  data_reserva DATE
  status VARCHAR(20)
}

Ref: Editora.id < Livro.id // publica
Ref: Categoria.id < Livro.id // classifica
Ref: Livro.id < LivroAutor.id
Ref: Autor.id < LivroAutor.id
Ref: Usuário.id < Empréstimo.id // realiza
Ref: Livro.id < Empréstimo.id
Ref: Empréstimo.id - Multa.id // gera
Ref: Usuário.id < Reserva.id // reserva