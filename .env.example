# Resend — never commit the real key. Copy to .env
RESEND_API_KEY=
MAIL_FROM=DBDraw <not-reply@dbdraw.io>
# Public site used in magic-link emails. Leave empty to use the request Host
# (handy in local dev) or set https://www.dbdraw.io in production.
SITE_URL=https://www.dbdraw.io
# Session cookie: HttpOnly dbdraw_sid, 7-day Max-Age, SameSite=Lax.
# Secure is inferred from HTTPS (trust proxy). Force with true/false if needed.
# COOKIE_SECURE=true
PORT=3000
HOST=127.0.0.1
